#!/bin/bash
# e2s.pbs -- E2 on ONE whole node: all rank counts 1..72 in the same job (same hardware, same-job 1-rank baseline).
#   qsub -l select=1:ncpus=72 -l walltime=01:30:00 pbs/e2s.pbs        (optional: -l place=excl, -v RANKS=...)
#PBS -N p3_e2s
#PBS -l select=1:ncpus=72
#PBS -l walltime=01:30:00
#PBS -j oe
REPO=${REPO:-${PBS_O_WORKDIR:-$PWD}}     # submit from the scaling_2d3d directory (qsub pbs/....pbs)
cd "$REPO" || exit 1
module load ${MODULES:-nvhpc-hpcx-cuda12/26.1}
# Optional: CPU_ONLY=1 accepts only cn-* nodes (other nodes => exit 3, resubmitted by submit_retry.sh).  Default 0 = any node, as published.
if [ "${CPU_ONLY:-0}" = 1 ] && sort -u $PBS_NODEFILE | sed 's/\..*//' | grep -qviE '^cn-[0-9]+$'; then
  echo "NOT_CPU_NODES: $(sort -u $PBS_NODEFILE | sed 's/\..*//' | tr '\n' ' ')"; exit 3
fi
NC=$(awk '/^Cpus_allowed_list/ {print $2}' /proc/self/status | tr ',' '\n' | awk -F- 'NF==2 {s+=$2-$1+1; next} NF==1 && $1!="" {s+=1} END{print s+0}')
echo "== host $(hostname) cpuset $(awk '/^Cpus_allowed_list/ {print $2}' /proc/self/status) cores=$NC  jobid=${PBS_JOBID:-}"
echo "== cpu: $(lscpu | sed -n 's/^Model name: *//p'); sockets $(lscpu | sed -n 's/^Socket(s): *//p'); NUMA nodes $(lscpu | sed -n 's/^NUMA node(s): *//p')"
[ "$NC" -ge 72 ] || echo "WARNING: only $NC cores: ranks above $NC are skipped (results incomplete)"
export BIN=/tmp/p3bin_${PBS_JOBID:-$$}; export RES=$REPO/results_rerun
make -C src BIN=$BIN ARCH_FLAGS="${ARCH_FLAGS:--march=native}" poisson >/dev/null || exit 1
# NAME=e2s_r1, e2s_r2 ... : each independent job writes its own directory + csv (needed by the 2-job trust criterion)
export NAME=${NAME:-e2s_r1}
bash scripts/run_e2s.sh; rc=$?
rm -rf "$BIN"; echo "##### E2S_DONE rc=$rc #####"; exit $rc
